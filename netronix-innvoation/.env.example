# ==============================================================================
# Netronix Innovation - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' in local development or set these variables in production.

# Backend API Base URL
# When developing locally with an Express/FastAPI/Nest backend:
# VITE_API_BASE_URL=http://localhost:5000/api
# In production:
# VITE_API_BASE_URL=https://api.netronixinnovation.com/api
VITE_API_BASE_URL=/api

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Optional Analytics Tracking ID
VITE_GA_TRACKING_ID=
